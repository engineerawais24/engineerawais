{
  "manifest_version": 3,
  "name": "CareerPilot Helper",
  "version": "1.0.0",
  "description": "Save the job you're viewing into CareerPilot and autofill application forms from your own profile. Fills only empty fields, never overwrites your answers, never submits.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "CareerPilot Helper"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:8000/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*",
        "https://127.0.0.1/*",
        "https://localhost/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.greenhouse.io/*",
        "*://*.lever.co/*",
        "*://*.myworkdayjobs.com/*",
        "*://*.myworkdaysite.com/*",
        "*://*.successfactors.com/*",
        "*://*.successfactors.eu/*",
        "*://*.smartrecruiters.com/*",
        "*://*.taleo.net/*",
        "*://*.icims.com/*",
        "*://*.oraclecloud.com/*"
      ],
      "js": ["storage.js", "ats-engine.js", "content.js", "auto-apply.js"],
      "run_at": "document_idle"
    }
  ]
}
